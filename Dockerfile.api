# API image: the Fastify server (server/ workspace). Secrets (RPC URLs)
# arrive via Vault Agent / container env — nothing is baked at build time.
#
# Runtime layout (WORKDIR /app/server, `node dist/index.js`, port 3001)
# deliberately matches the simple-staking-widget PoC image: both are
# deployed by the SAME `staking-widget` helm release, so command/port
# expectations in the chart values must keep working unchanged.

FROM node:24-alpine AS builder
WORKDIR /app

# .yarn/releases is the committed yarn pinned by yarnPath in .yarnrc.yml;
# the stock Yarn 1 from the node image delegates to it — no corepack needed
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
COPY server/package.json server/package.json
RUN HUSKY=0 yarn install --immutable

COPY . .
# esbuild bundles server/src + the framework-neutral repo-root modules it
# imports (ABIs, networks/*.json, earn fetchers) into a single ESM file;
# node_modules stay external.
RUN yarn workspace api build

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# Production node_modules only (the esbuild bundle keeps packages external).
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
COPY server/package.json server/package.json
RUN HUSKY=0 yarn workspaces focus api --production && yarn cache clean

COPY --from=builder /app/server/dist server/dist
# build-info.json is read by the metrics module (also inlined into the
# bundle at build; kept on disk for parity/debugging).
COPY build-info.json ./

USER node
WORKDIR /app/server
EXPOSE 3001
CMD ["node", "dist/index.js"]
