# API image: the Fastify server (server/ workspace), on Docker Hardened Images
# (need `docker login dhi.io`). Shell and apk exist only in the -dev stages.
# Secrets (RPC URLs) arrive via Vault Agent: the chart starts node with
# --env-file, nothing is baked at build time.
#
# Runtime layout (WORKDIR /app/server, `node dist/index.js`, port 3001)
# matches the simple-staking-widget chart values.

ARG NODE_VERSION=24.22.3
ARG ALPINE_VERSION=3.24
ARG DHI_DEV_DIGEST=sha256:7d604b901f18f4e8660af65dab69ce256fb4080e95309e00a105b931271babfd
ARG DHI_RUNTIME_DIGEST=sha256:4544851709621aa77a18134101ef4cd6af39233cf57bdfe2adcc17e2e72866db

FROM dhi.io/node:${NODE_VERSION}-alpine${ALPINE_VERSION}-dev@${DHI_DEV_DIGEST} AS builder
WORKDIR /app

# The image's Yarn 1 delegates to the committed release (yarnPath in .yarnrc.yml)
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
COPY server/package.json server/package.json
RUN HUSKY=0 yarn install --immutable

COPY . .
# esbuild bundles server/src + the framework-neutral repo-root modules it
# imports (ABIs, networks/*.json, earn fetchers) into a single ESM file;
# node_modules stay external.
RUN yarn workspace api build

# Production node_modules only (the esbuild bundle keeps packages external)
FROM dhi.io/node:${NODE_VERSION}-alpine${ALPINE_VERSION}-dev@${DHI_DEV_DIGEST} AS prod-deps
WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
COPY server/package.json server/package.json
# server/node_modules exists only when a package cannot be hoisted; created so the COPY below never misses it
RUN HUSKY=0 yarn workspaces focus api --production && yarn cache clean && \
    mkdir -p server/node_modules

FROM dhi.io/node:${NODE_VERSION}-alpine${ALPINE_VERSION}@${DHI_RUNTIME_DIGEST} AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=prod-deps /app/node_modules node_modules
COPY --from=prod-deps /app/server/node_modules server/node_modules
COPY server/package.json server/package.json
COPY --from=builder /app/server/dist server/dist
# build-info.json is read by the metrics module (also inlined into the
# bundle at build; kept on disk for parity/debugging).
COPY --from=builder /app/build-info.json build-info.json

# node (1000), the user the DHI runtime runs as
USER 1000
WORKDIR /app/server
EXPOSE 3001
CMD ["node", "dist/index.js"]
