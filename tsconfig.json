{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    // The TS-6-deprecated `moduleResolution: node` + `baseUrl` pair is gone:
    // Vite is the bundler, so `bundler` resolution + explicit `paths` is both
    // the correct model and the TS 7 migration the old config deferred.
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "types": ["vite/client", "node"],
    "paths": {
      "abi/*": ["./abi/*"],
      "assets/*": ["./assets/*"],
      "config": ["./config/index.ts"],
      "config/*": ["./config/*"],
      "consts/*": ["./consts/*"],
      "features/*": ["./features/*"],
      "modules/*": ["./modules/*"],
      "networks/*": ["./networks/*"],
      "providers": ["./providers/index.tsx"],
      "providers/*": ["./providers/*"],
      "shared/*": ["./shared/*"],
      "styles": ["./styles/index.ts"],
      "styles/*": ["./styles/*"],
      "types": ["./types/index.ts"],
      "types/*": ["./types/*"],
      "utils": ["./utils/index.ts"],
      "utils/*": ["./utils/*"],
      "@lidofinance/lido-ui": [
        "./node_modules/@lidofinance/lido-ui/dist/types/index.d.ts"
      ],
      "@lidofinance/satanizer": [
        "./node_modules/@lidofinance/satanizer/dist/index.d.ts"
      ],
      "@lidofinance/api-metrics": [
        "./node_modules/@lidofinance/api-metrics/dist/index.d.ts"
      ],
      "@lidofinance/analytics-matomo": [
        "./node_modules/@lidofinance/analytics-matomo/dist/index.d.ts"
      ],
      "@lidofinance/lido-ui": [
        "./node_modules/@lidofinance/lido-ui/dist/types/index.d.ts"
      ],
      "@lidofinance/analytics-matomo": [
        "./node_modules/@lidofinance/analytics-matomo/dist/index.d.ts"
      ],
      "@lidofinance/satanizer": [
        "./node_modules/@lidofinance/satanizer/dist/index.d.ts"
      ],
      "@lidofinance/api-metrics": [
        "./node_modules/@lidofinance/api-metrics/dist/index.d.ts"
      ],
      "next/router": ["./shims/next-router.tsx"],
      "next/link": ["./shims/next-link.tsx"],
      "next/head": ["./shims/next-head.tsx"],
      "next/config": ["./shims/next-config.tsx"],
      "next/dynamic": ["./shims/next-dynamic.tsx"],
      "next/app": ["./shims/next-app.ts"],
      "next": ["./shims/next-types.ts"],
      "env-dynamics.mjs": ["./env-dynamics.mjs"],
      "IPFS.json": ["./IPFS.json"],
      "build-info.json": ["./build-info.json"]
    }
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist", "server", "coverage", "playwright-report"]
}
