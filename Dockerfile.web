# Web image: static Vite build served by nginx-unprivileged. No Node at
# runtime — the api lives in its own image (Dockerfile.api).

FROM node:24-alpine AS builder
WORKDIR /app

# corepack pins the repo's Yarn 4 from packageManager.
RUN corepack enable

COPY package.json yarn.lock .yarnrc.yml ./
COPY server/package.json server/package.json
# --immutable: fail on lockfile drift. HUSKY=0 skips the postinstall hook
# (no .git in the image).
RUN HUSKY=0 yarn install --immutable

COPY . .
# window-env.js placeholder is generated at container start by the nginx
# entrypoint; the build only needs the static bundle. BUILD env can inject
# BASE_PATH if ever needed.
RUN yarn build:web

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Read-only root FS friendly: nginx writes cache + tmp into
# /var/cache/nginx and /tmp, which the helm chart mounts as emptyDir.
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf

# Config templates are rendered by our entrypoint at container start
# (into /var/cache/nginx) — see infra/nginx/entrypoint.sh. They live under
# a non-default path so the image's own 20-envsubst-on-templates.sh doesn't
# try (and fail) to process them.
COPY infra/nginx/default.conf.template /etc/nginx/template-src/default.conf.template
COPY infra/nginx/security-headers.conf.template /etc/nginx/template-src/security-headers.conf.template

# Static assets from the build stage.
COPY --from=builder /app/dist /usr/share/nginx/html

# Runtime env script + nginx config are (re)written at container start.
COPY --chmod=755 infra/nginx/entrypoint.sh /docker-entrypoint.d/40-render-runtime-config.sh

EXPOSE 8080
