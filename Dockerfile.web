# Web image: static Vite build served by nginx-unprivileged.
# Node.js used only for build and to generate env file at runtime

#
# ################# Build Stage ##########################
#
FROM node:24-alpine AS builder
WORKDIR /app

# Dependency layer install with yarn binary version from project
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
COPY server/package.json server/package.json
RUN HUSKY=0 yarn install --immutable

# App layer
COPY . .

# env-free build
RUN yarn build:web


#
# ################# Runtime Stage ##########################
#
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Add node(w/ libstdc++ dep) for runtime env file generation
COPY --from=builder /usr/local/bin/node /usr/local/bin/node
COPY --from=builder /usr/lib/libstdc++.so.6 /usr/lib/libgcc_s.so.1 /usr/lib/

# Read-only root FS friendly: nginx writes cache + tmp into
# /var/cache/nginx and /tmp, which the helm chart mounts as emptyDir.
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infra/nginx/default.conf.template /etc/nginx/template-src/default.conf.template
COPY infra/nginx/security-headers.conf.template /etc/nginx/template-src/security-headers.conf.template

# Runtime env script + nginx config are (re)written at container start.
COPY --chmod=755 infra/nginx/entrypoint.sh /docker-entrypoint.d/40-render-runtime-config.sh

# Self-contained window-env CLI bundle (esbuild output, no node_modules),
# outside the html root so it is never served.
COPY --from=builder /app/dist-node/window-env-cli.mjs /etc/nginx/window-env-cli.mjs

# Static assets — changes every release, so it goes last: everything above
# stays layer-cache-stable across builds.
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080
