# Web image: static Vite build served by nginx-unprivileged. No Node at
# runtime — the api lives in its own image (Dockerfile.api).

FROM node:24-alpine AS builder
WORKDIR /app

# .yarn/releases is the committed yarn pinned by yarnPath in .yarnrc.yml;
# the stock Yarn 1 from the node image delegates to it — no corepack needed
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
COPY server/package.json server/package.json
# --immutable: fail on lockfile drift. HUSKY=0 skips the postinstall hook
# (no .git in the image).
RUN HUSKY=0 yarn install --immutable

COPY . .
# Built env-free: the HTML keeps a window.__env__ placeholder that the
# nginx entrypoint substitutes per environment at container start. BUILD
# env can inject BASE_PATH if ever needed.
RUN yarn build:web

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Node runtime for the entrypoint's window-env CLI: it prints the processed
# client env JSON at boot (transforms + validation live in
# config/client-env-manifest.ts — no env logic in shell). Runs once per
# container start, never serves traffic. The base image is unprivileged —
# switch to root for apk alone.
USER root
RUN apk add --no-cache nodejs
USER 101

# Read-only root FS friendly: nginx writes cache + tmp into
# /var/cache/nginx and /tmp, which the helm chart mounts as emptyDir.
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf

# Config templates are rendered by our entrypoint at container start
# (into /var/cache/nginx) — see infra/nginx/entrypoint.sh. They live under
# a non-default path so the image's own 20-envsubst-on-templates.sh doesn't
# try (and fail) to process them.
COPY infra/nginx/default.conf.template /etc/nginx/template-src/default.conf.template
COPY infra/nginx/security-headers.conf.template /etc/nginx/template-src/security-headers.conf.template

# Static assets from the build stage.
COPY --from=builder /app/dist /usr/share/nginx/html

# Self-contained window-env CLI bundle (esbuild output, no node_modules),
# outside the html root so it is never served.
COPY --from=builder /app/dist-node/window-env-cli.mjs /etc/nginx/window-env-cli.mjs

# Runtime env script + nginx config are (re)written at container start.
COPY --chmod=755 infra/nginx/entrypoint.sh /docker-entrypoint.d/40-render-runtime-config.sh

EXPOSE 8080
