{
  "name": "lido-staking-widget",
  "version": "1.60.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"yarn dev:web\" \"yarn workspace api dev\"",
    "dev:web": "node --env-file-if-exists=.env.local scripts/write-validation-file.mjs && vite dev",
    "dev:ipfs": "IPFS_MODE=true vite dev",
    "build": "yarn build:web && yarn workspace api build",
    "build:web": "node --env-file-if-exists=.env.local scripts/write-validation-file.mjs && vite build && yarn build:window-env-cli",
    "build:window-env-cli": "esbuild scripts/window-env-cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-node/window-env-cli.mjs",
    "build:ipfs": "IPFS_MODE=true vite build",
    "preview:web": "vite preview",
    "start:api": "yarn workspace api start",
    "lint": "eslint . && yarn lint:css",
    "lint:fix": "eslint . --fix && yarn lint:css --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "types": "tsc --noEmit && yarn workspace api types",
    "postinstall": "husky",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "vitest run && yarn workspace api test:unit",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.6",
    "@cowprotocol/widget-react": "3.2.0",
    "@lidofinance/analytics-matomo": "0.64.0",
    "@lidofinance/lido-app-ui": "1.1.3",
    "@lidofinance/lido-ethereum-sdk": "4.8.0",
    "@lidofinance/lido-ui": "3.43.0",
    "@lidofinance/rpc": "0.64.0",
    "@metamask/connect-evm": "2.1.1",
    "@safe-global/safe-apps-provider": "~0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": "^5.85.6",
    "@walletconnect/ethereum-provider": "^2.23.8",
    "copy-to-clipboard": "^3.3.1",
    "echarts": "^6.1.0",
    "js-cookie": "^3.0.7",
    "lodash": "^4.18.1",
    "ms": "^2.1.3",
    "nprogress": "^0.2.0",
    "react": "^18.2.0",
    "react-device-detect": "^1.17.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.45.2",
    "react-is": "^18.2.0",
    "react-router": "^7.6.0",
    "reef-knot": "8.3.0",
    "styled-components": "^5.3.5",
    "tiny-invariant": "^1.1.0",
    "viem": "2.55.11",
    "wagmi": "3.7.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@commitlint/prompt": "20.3.1",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/js-cookie": "^3.0.0",
    "@types/lodash": "^4.14.186",
    "@types/ms": "^0.7.31",
    "@types/node": "^24.3.0",
    "@types/nprogress": "^0.2.0",
    "@types/react": "^18.2.22",
    "@types/styled-components": "^5.1.23",
    "@types/styled-system": "^5.1.17",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsonschema": "^1.4.1",
    "lint-staged": "17.0.8",
    "node-html-parser": "^6.1.12",
    "postcss-preset-env": "^11.5.1",
    "prettier": "3.9.5",
    "stylelint": "^17.14.1",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "^8.0.0",
    "vite-plugin-sri-gen": "^1.7.3",
    "vite-plugin-svgr": "^4.3.0",
    "vite-prerender-plugin": "^0.5.13",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "./**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "./**/*.css": [
      "stylelint"
    ],
    "./**/*.{ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1% and last 2 versions",
    "last 1 ios_saf major versions",
    "not dead",
    "not ie >= 0",
    "not op_mini all"
  ],
  "resolutions": {
    "elliptic": "^6.6.1",
    "@babel/runtime": "^7.26.10",
    "eslint-plugin-sonarjs/typescript": "6.0.3",
    "@types/node": "^24.3.0"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
