{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/index.js && node scripts/check-externals.mjs",
    "start": "node dist/index.js",
    "types": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "@lidofinance/api-metrics": "0.64.0",
    "@lidofinance/lido-ethereum-sdk": "4.11.0",
    "@lidofinance/satanizer": "0.64.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "lru-cache": "11.5.3",
    "prom-client": "^15.1.3",
    "tiny-invariant": "1.3.3",
    "viem": "2.58.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.12"
  }
}
