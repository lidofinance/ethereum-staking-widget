{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/index.js && node scripts/check-externals.mjs",
    "start": "node dist/index.js",
    "types": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "@lidofinance/api-metrics": "^0.48.0",
    "@lidofinance/lido-ethereum-sdk": "4.8.0",
    "@lidofinance/satanizer": "^0.48.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "lru-cache": "11.4.0",
    "prom-client": "^15.1.3",
    "tiny-invariant": "^1.1.0",
    "viem": "2.55.11",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.9"
  }
}
